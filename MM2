local function flingPlayerReal(targetPlayer)
    if not targetPlayer or targetPlayer == player then return false end
    local targetChar = targetPlayer.Character
    if not targetChar then return false end
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar:FindFirstChild("Humanoid")
    if not targetHRP or not targetHum then return false end
    pcall(function() targetHRP:SetNetworkOwner(player) end)
    task.wait(0.05)
    local bv = Instance.new("BodyVelocity")
    bv.Name = "ShadowFling"
    bv.Parent = targetHRP
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "ShadowFlingAng"
    bav.Parent = targetHRP
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(9e8, 9e8, 9e8)
    pcall(function() targetHum.PlatformStand = true end)
    task.delay(1.2, function()
        if bv and bv.Parent then bv:Destroy() end
        if bav and bav.Parent then bav:Destroy() end
        if targetHum and targetHum.Parent then pcall(function() targetHum.PlatformStand = false end) end
    end)
    return true
end

