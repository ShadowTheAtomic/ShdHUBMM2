    task.wait(0.1)
    pcall(function() gun.Parent = player.Backpack end)
    task.wait(0.15)
    if CONFIG.GunReturnAfterCollect then hrp.CFrame = origCF hrp.Velocity = origVel end
    state.gunCollecting = false
end

