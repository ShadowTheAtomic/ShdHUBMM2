-- ============ CANDY FARM REAL ============
local function getCandyHolder()
    local names = {"CandyHolder", "Candies", "Candy", "HalloweenCandy"}
    for _, n in ipairs(names) do
        local f = Workspace:FindFirstChild(n)
        if f then return f end
    end
    local ign = Workspace:FindFirstChild("Ignore")
    if ign then
        for _, n in ipairs(names) do
            local f = ign:FindFirstChild(n)
            if f then return f end
        end
    end
    return nil
end

local function collectCandiesReal()
    local holder = getCandyHolder()
    if not holder then return 0 end
    local hrp = getHRP()
    if not hrp then return 0 end
    local collected = 0
    local events = ReplicatedStorage:FindFirstChild("Events")
    local updateEvent = events and events:FindFirstChild("UpdateData")
    for _, candy in ipairs(holder:GetChildren()) do
        if not CONFIG.AutoCandy and collected > 0 then break end
        if candy:IsA("BasePart") then
            hrp.CFrame = candy.CFrame
            task.wait(0.08)
            if updateEvent then pcall(function() updateEvent:InvokeServer() end) end
            collected = collected + 1
            state.candyCount = state.candyCount + 1
            if state.candyCount - state.candyLastNotify >= 10 then
                state.candyLastNotify = state.candyCount
                notify("Shadow HUB", "🍬 " .. state.candyCount .. " doces", 2)
            end
            if CONFIG.CandyResetAfter > 0 and state.candyCount >= CONFIG.CandyResetAfter then
                state.candyCount = 0
                state.candyLastNotify = 0
                notify("Shadow HUB", "🍬 Reset (" .. CONFIG.CandyResetAfter .. ")", 3)
                local hum = getHum()
                if hum then
                    pcall(function() hum.Health = 0 end)
                    pcall(function() hum:TakeDamage(hum.MaxHealth * 2) end)
                end
                task.wait(2.5)
                break
            end
        end
    end
    return collected
end

local function startCandyFarm()
    if state.candyConn then return end
    state.candyConn = task.spawn(function()
        while CONFIG.AutoCandy do
            if not getHRP() then task.wait(0.5) continue end
            collectCandiesReal()
            task.wait(0.2)
        end
    end)
end

local function stopCandyFarm()
    if state.candyConn then
        pcall(function() task.cancel(state.candyConn) end)
        state.candyConn = nil
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "ShadowCandyESP" then obj:Destroy() end
    end
end

local function updateCandyESP()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "ShadowCandyESP" then obj:Destroy() end
    end
    if not CONFIG.CandyESP then return end
    local holder = getCandyHolder()
    if not holder then return end
    for _, obj in ipairs(holder:GetDescendants()) do
        if obj:IsA("BasePart") then
            local bb = Instance.new("BillboardGui")
            bb.Name = "ShadowCandyESP"
            bb.Size = UDim2.new(0, 80, 0, 40)
            bb.StudsOffset = Vector3.new(0, 2, 0)
            bb.AlwaysOnTop = true
            bb.MaxDistance = 2000
            bb.Parent = obj
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = "🍬"
            lbl.TextColor3 = Color3.fromRGB(255, 200, 50)
            lbl.TextStrokeTransparency = 0
            lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
            lbl.Font = Enum.Font.GothamBold
            lbl.TextScaled = true
            lbl.Parent = bb
        end
    end
end

