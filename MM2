local function generateConfigCode()
    local data = {}
    for _, key in ipairs(SHAREABLE_KEYS) do
        if CONFIG[key] ~= nil then data[key] = CONFIG[key] end
    end
    local json = HttpService:JSONEncode(data)
    local key = "SHDW"
    local out = ""
    for i = 1, #json do
        local byte = json:byte(i)
        local k = key:byte(((i - 1) % #key) + 1)
        pcall(function() out = out .. string.format("%02x", bit32.bxor(byte, k)) end)
    end
    return "SHDW-" .. out
end

local function loadConfigCode(code)
    if not code or code == "" then return false, "vazio" end
    code = code:gsub("^SHDW%-", "")
    if #code % 2 ~= 0 then return false, "inválido" end
    local key = "SHDW"
    local json = ""
    for i = 1, #code, 2 do
        local hex = code:sub(i, i + 1)
        local byte = tonumber(hex, 16)
        if not byte then return false, "hex inválido" end
        local k = key:byte(((i/2 - 1) % #key) + 1)
        json = json .. string.char(bit32.bxor(byte, k))
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" then return false, "json inválido" end
    local count = 0
    for k, v in pairs(data) do
        if CONFIG[k] ~= nil then CONFIG[k] = v count = count + 1 end
    end
    return true, count .. " configs"
end

