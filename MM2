-- ============ PERFECT AIM ============
local function paGetTarget(roleFilter)
    local myHrp = getHRP()
    if not myHrp then return nil end
    if CONFIG.SpecificAimTarget and CONFIG.SpecificAimTarget ~= "Nenhum" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name == CONFIG.SpecificAimTarget and plr ~= player then
                if isPlayerAlive(plr) then
                    local char = plr.Character
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChild("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        return {plr = plr, char = char, hrp = hrp, hum = hum, dist = (myHrp.Position - hrp.Position).Magnitude, role = getRole(plr)}
                    end
                end
            end
        end
        return nil
    end
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if not isPlayerAlive(plr) then continue end
        local role = getRole(plr)
        if role == "Dead" or role == "You" or role == "Unknown" then continue end
        if roleFilter and role ~= roleFilter then continue end
        local char = plr.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then continue end
        local d = (myHrp.Position - hrp.Position).Magnitude
        if d < bestDist then
            bestDist = d
            best = {plr = plr, char = char, hrp = hrp, hum = hum, dist = d, role = role}
        end
    end
    return best
end

local function paGetAimPart(target)
    if not target or not target.char then return nil end
    return target.char:FindFirstChild("Head") or target.char:FindFirstChild("UpperTorso") or target.hrp
end

local function paCalcAimPos(target, myHrp, aimPart)
    local aimPos = aimPart.Position
    if CONFIG.PerfectAimPredict then
        local dist = (myHrp.Position - aimPos).Magnitude
        local travelTime = dist / paBulletSpeed
        aimPos = aimPos + target.hrp.AssemblyLinearVelocity * travelTime * 0.6
    end
    return aimPos
end

local function paSnapCamera(aimPos)
    local myHrp = getHRP()
    if not myHrp then return end
    myHrp.CFrame = CFrame.new(myHrp.Position, aimPos)
    local cam = Workspace.CurrentCamera
    if cam then
        cam.CFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + (aimPos - cam.CFrame.Position).Unit)
    end
end

local function startPerfectAim()
    if state.perfectAimConn then return end
    state.perfectAimConn = RunService.RenderStepped:Connect(function()
        if not CONFIG.PerfectAim then return end
        local gun = player.Character and player.Character:FindFirstChild("Gun")
        if not gun then state.paLockedTarget = nil return end
        local myHrp = getHRP()
        if not myHrp then return end
        local target = paGetTarget(CONFIG.PerfectAimTargetRole)
        if not target then state.paLockedTarget = nil return end
        if CONFIG.PerfectAimLock then
            if not state.paLockedTarget or state.paLockedTarget.plr ~= target.plr
               or not state.paLockedTarget.hrp.Parent
               or (state.paLockedTarget.hum and state.paLockedTarget.hum.Health <= 0) then
                state.paLockedTarget = target
            end
            target = state.paLockedTarget
        end
        if not target or not target.hrp then return end
        local aimPart = paGetAimPart(target)
        if not aimPart then return end
        paSnapCamera(paCalcAimPos(target, myHrp, aimPart))
    end)
end

local function stopPerfectAim()
    if state.perfectAimConn then state.perfectAimConn:Disconnect() state.perfectAimConn = nil end
    state.paLockedTarget = nil
end

local function startPerfectAimFire()
    if state.perfectAimFireConn then return end
    state.perfectAimFireConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.PerfectAim or not CONFIG.PerfectAimAutoFire then return end
        local gun = player.Character and player.Character:FindFirstChild("Gun")
        if not gun then return end
        local myHrp = getHRP()
        if not myHrp then return end
        local target = paGetTarget(CONFIG.PerfectAimTargetRole)
        if not target then return end
        if target.dist > CONFIG.PerfectAimRange then return end
        local now = tick()
        if now - state.paLastShot < CONFIG.PerfectAimDelay then return end
        local aimPart = paGetAimPart(target)
        if not aimPart then return end
        local aimPos = paCalcAimPos(target, myHrp, aimPart)
        paSnapCamera(aimPos)
        RunService.RenderStepped:Wait()
        if target.hrp and target.hrp.Parent then
            local newAimPos = paCalcAimPos(target, myHrp, aimPart)
            paSnapCamera(newAimPos)
        end
        state.paLastShot = now
        pcall(function() gun:Activate() end)
        task.spawn(function()
            task.wait(0.02)
            pcall(function() gun:Activate() end)
        end)
    end)
end

local function stopPerfectAimFire()
    if state.perfectAimFireConn then state.perfectAimFireConn:Disconnect() state.perfectAimFireConn = nil end
end

-- ============ OLD AIM ============
local function startOldAim()
    if state.oldAimConn then return end
    state.oldAimConn = RunService.RenderStepped:Connect(function()
        if not CONFIG.OldAim then return end
        local gun = player.Character and player.Character:FindFirstChild("Gun")
        if not gun then state.oldAimTarget = nil return end
        local myHrp = getHRP()
        if not myHrp then return end
        local target = paGetTarget(CONFIG.AimTargetRole or "Murderer")
        if not target then state.oldAimTarget = nil return end
        if CONFIG.AimLockTarget then
            if not state.oldAimTarget or state.oldAimTarget.plr ~= target.plr or not state.oldAimTarget.hrp.Parent then
                state.oldAimTarget = target
            end
            target = state.oldAimTarget
        end
        local aimPart = target.char:FindFirstChild(CONFIG.AimTargetPart) or target.char:FindFirstChild("Head")
        if not aimPart then return end
        local aimPos = aimPart.Position
        local cam = Workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local dir = (aimPos - camPos).Unit
        if CONFIG.AimUseSmooth then
            cam.CFrame = CFrame.new(camPos, camPos + cam.CFrame.LookVector:Lerp(dir, CONFIG.AimSmoothness))
        else
            cam.CFrame = CFrame.new(camPos, camPos + dir)
        end
        local charDir = (aimPos - myHrp.Position).Unit
        myHrp.CFrame = CFrame.new(myHrp.Position, myHrp.Position + Vector3.new(charDir.X, 0, charDir.Z))
    end)
end

local function stopOldAim()
    if state.oldAimConn then state.oldAimConn:Disconnect() state.oldAimConn = nil end
    state.oldAimTarget = nil
end

local function startOldAimFire()
    if state.oldAimFireConn then return end
    state.oldAimFireConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.OldAim or not CONFIG.OldAimAutoFire then return end
        if tick() - state.oldAimLastShot < 0.1 then return end
        local gun = player.Character and player.Character:FindFirstChild("Gun")
        if not gun then return end
        local target = paGetTarget(CONFIG.AimTargetRole or "Murderer")
        if not target then return end
        local aimPart = target.char:FindFirstChild(CONFIG.AimTargetPart) or target.char:FindFirstChild("Head")
        if not aimPart then return end
        local aimPos = aimPart.Position
        local cam = Workspace.CurrentCamera
        local angle = math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot((aimPos - cam.CFrame.Position).Unit), -1, 1)))
        if angle <= CONFIG.AimFOV then
            state.oldAimLastShot = tick()
            gun:Activate()
        end
    end)
end

local function stopOldAimFire()
    if state.oldAimFireConn then state.oldAimFireConn:Disconnect() state.oldAimFireConn = nil end
end

