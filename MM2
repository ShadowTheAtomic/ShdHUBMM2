local function getRole(plr)
    if plr == player then return "You" end
    local char = plr.Character
    if not char then return "Unknown" end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return "Unknown" end
    if hum.Health <= 0 then return "Dead" end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return "Dead" end
    if char:FindFirstChild("Knife") then return "Murderer" end
    if char:FindFirstChild("Gun") then return "Sheriff" end
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") then return "Murderer" end
        if bp:FindFirstChild("Gun") then return "Sheriff" end
    end
    return "Innocent"
end

local function getMyRole()
    local char = player.Character
    if not char then return "Unknown" end
    if char:FindFirstChild("Knife") then return "Murderer" end
    if char:FindFirstChild("Gun") then return "Sheriff" end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") then return "Murderer" end
        if bp:FindFirstChild("Gun") then return "Sheriff" end
    end
    return "Innocent"
end

local function isPlayerAlive(plr)
    if plr == player then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return false end
    if hum.Health <= 0 then return false end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    local pg = plr:FindFirstChild("PlayerGui")
    if pg then
        local main = pg:FindFirstChild("Main")
        if main then
            local dead = main:FindFirstChild("Dead") or main:FindFirstChild("Spectate")
            if dead and dead.Visible then return false end
        end
    end
    return true
end

local function getClosestEnemy(roleFilter)
    local myHrp = getHRP()
    if not myHrp then return nil end
    local closest, closestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if not isPlayerAlive(plr) then continue end
        local role = getRole(plr)
        if role == "Dead" or role == "You" or role == "Unknown" then continue end
        if roleFilter and role ~= roleFilter then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (myHrp.Position - hrp.Position).Magnitude
            if d < closestDist then
                closestDist = d
                closest = {plr = plr, char = char, hrp = hrp, dist = d, role = role}
            end
        end
    end
    return closest
end

