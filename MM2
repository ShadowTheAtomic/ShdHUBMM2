local function collectGunWithReturn()
    if state.gunCollecting or tick() - state.lastGunScan < 1.0 then return end
    state.lastGunScan = tick()
    if hasGunAlready() then return end
    local gun = findDroppedGun()
    if not gun then return end
    local h = gun:FindFirstChild("Handle")
    if not h then return end
    local pos = h.Position
    local hrp = getHRP()
    if not hrp then return end
    state.gunCollecting = true
    local origCF, origVel = hrp.CFrame, hrp.Velocity
