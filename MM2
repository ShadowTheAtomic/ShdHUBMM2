local function updateESP()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "ShadowESP_Label" or obj.Name == "ShadowESP_HL" then obj:Destroy() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if not isPlayerAlive(plr) then continue end
        local char = plr.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        local role = getRole(plr)
        if role == "Dead" or role == "Unknown" then continue end
        local susData = suspiciousPlayers[plr]
        local susFlag = susData and susData.count >= 3
        if role == "Murderer" and CONFIG.ESPMurder then
            createESP(char, CONFIG.ESPColorMurder, "🔪 " .. plr.Name .. (susFlag and " 🚨" or ""), true)
        elseif role == "Sheriff" and CONFIG.ESPSheriff then
            createESP(char, CONFIG.ESPColorSheriff, "🔫 " .. plr.Name .. (susFlag and " 🚨" or ""), true)
        elseif role == "Innocent" and CONFIG.ESPInnocent then
            createESP(char, CONFIG.ESPColorInno, plr.Name .. (susFlag and " 🚨" or ""), true)
        end
    end
end

