    if hum then
        pcall(function() hum.Health = 0 end)
        pcall(function() hum:TakeDamage(hum.MaxHealth * 2) end)
    end
end

local function startRainbowSkin()
    if state.rainbowConn then return end
    state.rainbowConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.RainbowSkin then return end
        local hum = getHum()
        if not hum then return end
        local bc = hum:FindFirstChildOfClass("BodyColors")
        if not bc then return end
        local t = tick()
        local c = Color3.new((math.sin(t)+1)/2, (math.sin(t+2)+1)/2, (math.sin(t+4)+1)/2)
        bc.HeadColor3 = c bc.TorsoColor3 = c bc.LeftArmColor3 = c bc.RightArmColor3 = c bc.LeftLegColor3 = c bc.RightLegColor3 = c
    end)
end
local function stopRainbowSkin()
    if state.rainbowConn then state.rainbowConn:Disconnect() state.rainbowConn = nil end
end

local function applyNoHead(enabled)
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if head then head.Transparency = enabled and 1 or 0 end
end

local function applyHeadScale(scale)
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if head then
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh") mesh.MeshType = Enum.MeshType.Head mesh.Parent = head
        end
        mesh.Scale = Vector3.new(scale, scale, scale)
    end
end

local function applyBodySize(scale)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    pcall(function()
        if hum:FindFirstChild("BodyHeightScale") then hum.BodyHeightScale.Value = scale end
        if hum:FindFirstChild("BodyWidthScale") then hum.BodyWidthScale.Value = scale end
        if hum:FindFirstChild("BodyDepthScale") then hum.BodyDepthScale.Value = scale end
        if hum:FindFirstChild("HeadScale") then hum.HeadScale.Value = scale end
        hum:BuildRigFromAttachments()
    end)
end

local function applyUserSkin(userId)
    task.wait(0.5)
    local hum = getHum()
    if not hum then return end
    local savedSpeed = hum.WalkSpeed
    local savedJump = hum.JumpPower
    pcall(function()
        local desc = Players:GetHumanoidDescriptionFromUserIdAsync(userId)
        if desc then hum:ApplyDescription(desc) end
    end)
    task.wait(0.1)
    if hum then hum.WalkSpeed = savedSpeed if savedJump then hum.JumpPower = savedJump end end
end

-- ============ AI MODES ============
local function startAIPlay()
    if state.aiPlayConn then return end
    state.aiPlayConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.AIPlay then return end
        local myRole = getMyRole()
        local myHrp = getHRP()
        local myHum = getHum()
        if not myHrp or not myHum or myHum.Health <= 0 then return end
        local now = tick()
        if myRole == "Murderer" then
            local target = getClosestEnemy()
            if target then
                local knife = player.Character and player.Character:FindFirstChild("Knife")
                if knife then
                    if target.dist < 5 then
                        if now - state.lastActionTime > 0.5 then state.lastActionTime = now knife:Activate() end
                    else moveToPosition(target.hrp.Position) end
                end
            end
        elseif myRole == "Sheriff" then
            local murderer = getClosestEnemy("Murderer")
            local gun = player.Character and player.Character:FindFirstChild("Gun")
            if murderer and gun then
                if murderer.dist < 30 then
                    if now - state.lastActionTime > 0.3 then
                        state.lastActionTime = now
                        myHrp.CFrame = CFrame.new(myHrp.Position, murderer.hrp.Position)
                        gun:Activate()
                    end
                else moveToPosition(murderer.hrp.Position) end
            end
        else
            local murderer = getClosestEnemy("Murderer")
            local hasGun = player.Character and player.Character:FindFirstChild("Gun")
            if hasGun then
                if murderer and murderer.dist < 40 then
                    if now - state.lastActionTime > 0.3 then
                        state.lastActionTime = now
                        myHrp.CFrame = CFrame.new(myHrp.Position, murderer.hrp.Position)
                        hasGun:Activate()
                    end
                end
            elseif murderer and murderer.dist < 30 then
                local fleeDir = (myHrp.Position - murderer.hrp.Position).Unit
                moveToPosition(myHrp.Position + fleeDir * 40)
                if now - state.lastActionTime > 0.4 then state.lastActionTime = now aiStrafe() end
            end
        end
    end)
end
local function stopAIPlay()
    if state.aiPlayConn then state.aiPlayConn:Disconnect() state.aiPlayConn = nil end
end

local function startAutoJumpFlee()
    if state.autoJumpConn then return end
    state.autoJumpConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.AutoJumpFlee then return end
        local myHrp = getHRP()
        local myHum = getHum()
        if not myHrp or not myHum then return end
        local now = tick()
        if now - state.lastJumpTime < 0.8 then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == player then continue end
            if not isPlayerAlive(plr) then continue end
            local char = plr.Character
            if not char then continue end
            local role = getRole(plr)
            if role == "Murderer" or role == "Sheriff" then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and (myHrp.Position - hrp.Position).Magnitude < CONFIG.AutoJumpRange then
                    myHum:ChangeState(Enum.HumanoidStateType.Jumping)
                    state.lastJumpTime = now
                    break
                end
            end
        end
    end)
end
local function stopAutoJumpFlee()
    if state.autoJumpConn then state.autoJumpConn:Disconnect() state.autoJumpConn = nil end
end

