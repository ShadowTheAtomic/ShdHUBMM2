            task.wait(0.02)
            local start = h.Position
            if not start then return end
            task.wait(0.05)
            local curr = h.Position
            if not curr then return end
            local hrp = getHRP()
            if not hrp then return end
            local dir = (curr - start).Unit
            local toMe = (hrp.Position - curr).Unit
            if dir:Dot(toMe) > 0.6 and (hrp.Position - curr).Magnitude < CONFIG.DodgeRange then
                local perp = dir:Cross(Vector3.new(0, 1, 0)).Unit
                hrp.CFrame = CFrame.new(hrp.Position + perp * (math.random(1,2)==1 and 1 or -1) * 18)
            end
        end)
    end)
end
