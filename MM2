-- ============ DETECTORES ============
local suspiciousPlayers = {}
local playerTracking = {}

local function addSuspicion(plr, reason)
    if not suspiciousPlayers[plr] then
        suspiciousPlayers[plr] = { count = 0, reasons = {}, firstSeen = tick() }
    end
    suspiciousPlayers[plr].count = suspiciousPlayers[plr].count + 1
    table.insert(suspiciousPlayers[plr].reasons, reason)
    if #suspiciousPlayers[plr].reasons > 10 then table.remove(suspiciousPlayers[plr].reasons, 1) end
    if CONFIG.NotifySuspicious then notify("🚨 SUSPEITO: " .. plr.Name, reason, 4) end
end

local function trackPlayer(plr)
    if plr == player then return end
    playerTracking[plr] = {lastPos=nil, lastPosTime=tick(), lastHealth=100, airStart=nil,
        speedHistory={}, speedFlags=0, speedMedFlags=0, wsFlags=0}
end

local function checkSuspicious(plr)
    local track = playerTracking[plr]
    if not track then return end
    if not isPlayerAlive(plr) then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    local now = tick()
    local pos = hrp.Position
    if track.lastPos then
        local moved = (pos - track.lastPos).Magnitude
        local dt = now - track.lastPosTime
        local instantSpeed = moved / math.max(dt, 0.001)
        table.insert(track.speedHistory, instantSpeed)
        if #track.speedHistory > 30 then table.remove(track.speedHistory, 1) end
        local avgSpeed = 0
        for _, s in ipairs(track.speedHistory) do avgSpeed = avgSpeed + s end
        avgSpeed = avgSpeed / #track.speedHistory
        local baseSpeed = hum.WalkSpeed
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {char}
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local result = Workspace:Raycast(pos, Vector3.new(0, -15, 0), rp)
        local isInAir = not result
        if avgSpeed > 50 then
            track.speedFlags = (track.speedFlags or 0) + 1
            if track.speedFlags >= 15 then addSuspicion(plr, "Speed Hack") track.speedFlags = 0 end
        elseif avgSpeed > 35 then
            track.speedMedFlags = (track.speedMedFlags or 0) + 1
            if track.speedMedFlags >= 40 then addSuspicion(plr, "Velocidade") track.speedMedFlags = 0 end
        end
        if baseSpeed > 30 then
            track.wsFlags = (track.wsFlags or 0) + 1
            if track.wsFlags >= 10 then addSuspicion(plr, "WS") track.wsFlags = 0 end
        end
        if isInAir and avgSpeed > 20 then
            if not track.airStart then track.airStart = now end
            if now - track.airStart > 5 then addSuspicion(plr, "Fly") track.airStart = now - 4 end
        else track.airStart = nil end
        if moved > 500 and dt < 0.5 and track.lastHealth == hum.Health and hum.Health > 0 then
            addSuspicion(plr, "TP")
        end
    end
    track.lastPos = pos
    track.lastPosTime = now
    track.lastHealth = hum.Health
end

local function startSuspiciousDetector()
    for _, plr in ipairs(Players:GetPlayers()) do trackPlayer(plr) end
    Players.PlayerAdded:Connect(trackPlayer)
    Players.PlayerRemoving:Connect(function(plr) playerTracking[plr] = nil suspiciousPlayers[plr] = nil end)
    RunService.Heartbeat:Connect(function()
        if not CONFIG.DetectSuspicious then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then pcall(checkSuspicious, plr) end
        end
    end)
end

local teamTracking = {murderer=nil, sheriff=nil, closeStart=nil, murdererHp=100, sheriffHp=100, lastFlagTime=0}

local function checkTeam()
    if not CONFIG.DetectTeam then return end
    local murderer, sheriff = nil, nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if not isPlayerAlive(plr) then continue end
        local role = getRole(plr)
        if role == "Murderer" then murderer = plr
        elseif role == "Sheriff" then sheriff = plr end
    end
    if not murderer or not sheriff then
        teamTracking.murderer = nil teamTracking.sheriff = nil teamTracking.closeStart = nil
        return
    end
    local mHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local sHRP = sheriff.Character:FindFirstChild("HumanoidRootPart")
    local mHum = murderer.Character:FindFirstChild("Humanoid")
    local sHum = sheriff.Character:FindFirstChild("Humanoid")
    if not mHRP or not sHRP or not mHum or not sHum then return end
    if teamTracking.murderer ~= murderer or teamTracking.sheriff ~= sheriff then
        teamTracking.murderer = murderer teamTracking.sheriff = sheriff teamTracking.closeStart = nil
        teamTracking.murdererHp = mHum.Health teamTracking.sheriffHp = sHum.Health
    end
    if mHum.Health < teamTracking.murdererHp or sHum.Health < teamTracking.sheriffHp then
        teamTracking.closeStart = nil
        teamTracking.murdererHp = mHum.Health teamTracking.sheriffHp = sHum.Health
        return
    end
    teamTracking.murdererHp = mHum.Health teamTracking.sheriffHp = sHum.Health
    local dist = (mHRP.Position - sHRP.Position).Magnitude
    local now = tick()
    if dist < TEAM_DISTANCE then
        if not teamTracking.closeStart then teamTracking.closeStart = now end
        if now - teamTracking.closeStart >= TEAM_TIME then
            if now - teamTracking.lastFlagTime > TEAM_COOLDOWN then
                teamTracking.lastFlagTime = now
                addSuspicion(murderer, "TEAM")
                addSuspicion(sheriff, "TEAM")
                notify("🚨 TEAM", murderer.Name .. " + " .. sheriff.Name, 6)
            end
            teamTracking.closeStart = now - TEAM_TIME + 2
        end
    else teamTracking.closeStart = nil end
end

local function startTeamDetector()
    RunService.Heartbeat:Connect(function()
        if not CONFIG.DetectTeam then return end
        pcall(checkTeam)
    end)
end

